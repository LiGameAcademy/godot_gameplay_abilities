[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://addons/godot_gameplay_abilities/scripts/status/gameplay_status_data.gd" id="1_status"]
[ext_resource type="Script" path="res://addons/godot_gameplay_abilities/scripts/effects/gameplay_effect.gd" id="2_effect"]
[ext_resource type="Script" path="res://addons/godot_gameplay_abilities/scripts/effects/ge_attribute_modifier.gd" id="3_apply"]
[ext_resource type="Script" path="res://addons/godot_gameplay_abilities/scripts/attributes/gameplay_attribute_modifier.gd" id="4_modifier"]
[ext_resource type="Script" path="res://addons/godot_gameplay_abilities/scripts/status/stacking/stacking_refresh_and_stack.gd" id="5_stacking"]

[sub_resource type="Resource" id="Resource_bonus"]
script = ExtResource("4_modifier")
attribute_id = &"power"
value = 3.0
modifier_type = 0

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("3_apply")
attribute_component_name = &"GameplayAttributeComponent"
modifiers = Array[ExtResource("4_modifier")]([SubResource("Resource_bonus")])

[sub_resource type="Resource" id="Resource_stacking"]
script = ExtResource("5_stacking")

[resource]
script = ExtResource("1_status")
status_id = &"short_bonus"
duration = 0.5
apply_effects = Array[ExtResource("2_effect")]([SubResource("Resource_effect")])
stacking_policy = SubResource("Resource_stacking")
max_stacks = 2
